# Credenciais dos usuários para os testes E2E Playwright
# Copie este arquivo para .env.test e preencha com as senhas reais do banco.
# .env.test NÃO deve ser commitado no git (adicione ao .gitignore).

# Condômino 1
E2E_CONDOMINO_EMAIL=ana@predial.com
E2E_CONDOMINO_SENHA=123456

# Condômino 2 (para testes de isolamento)
E2E_CONDOMINO2_EMAIL=carlos@predial.com
E2E_CONDOMINO2_SENHA=123456

# Prestador (especialidade Elétrica)
E2E_PRESTADOR_EMAIL=joao@predial.com
E2E_PRESTADOR_SENHA=123456

# Prestador 2 (especialidade Hidráulica — para testes de isolamento RN03)
