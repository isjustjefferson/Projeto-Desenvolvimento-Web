{
  "info": {
    "_postman_id": "a918e7d2-7b24-4f2a-b73f-c399b92e8df1",
    "name": "Sistema de Gestão de Chamados - API",
    "description": "Coleção oficial de testes de API (QA: Arthur José). Cobre autenticação, RBAC, ciclo de vida de chamados (CONDOMINO, PRESTADOR, SINDICO, ADMINISTRADOR), orçamentos e health check.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const conta = pm.request.headers.get('X-Conta-Teste');",
          "if (conta) {",
          "  pm.request.headers.remove('X-Conta-Teste');",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/auth/login',",
          "    method: 'POST',",
          "    header: {'Content-Type': 'application/json'},",
          "    body: {mode: 'raw', raw: JSON.stringify({email: conta, senha: '123456'})}",
          "  }, (erro, resposta) => {",
          "    if (erro || resposta.code !== 200) throw new Error('Falhou o login da conta de teste.');",
          "    const cookie = resposta.headers.get('Set-Cookie');",
          "    if (!cookie) throw new Error('O login não retornou um cookie de sessão.');",
          "    pm.request.headers.upsert({key: 'Cookie', value: cookie.split(';')[0]});",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Autenticação & Perfil",
      "item": [
        {
          "name": "Login (Sucesso - Condômino)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Deve retornar usuário sem expor senha\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('usuario');",
                  "    pm.expect(data.usuario.email).to.eql('ana@predial.com');",
                  "    pm.expect(data.usuario.role).to.eql('CONDOMINO');",
                  "    pm.expect(data.usuario).to.not.have.property('senha');",
                  "    pm.expect(data.usuario).to.not.have.property('senhaHash');",
                  "    pm.expect(pm.response.headers.get('Set-Cookie')).to.include('predial_sessao=');",
                  "    pm.environment.set(\"usuarioId\", data.usuario.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@predial.com\",\n  \"senha\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
