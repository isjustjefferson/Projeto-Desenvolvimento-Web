{
  "name": "gestao-chamados-qa",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:backend && npm run test:api && npm run test:frontend",
    "test:backend": "npm --prefix ../backend test",
    "test:api": "npm --prefix ../backend run test:e2e",
    "test:frontend": "npm --prefix ../frontend test",
    "test:e2e": "npm --prefix ./e2e run test",
    "test:e2e:headed": "npm --prefix ./e2e run test:headed",
    "test:e2e:ui": "npm --prefix ./e2e run test:ui",
    "test:all": "npm run test && npm run test:e2e"
  }
}
